<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Praise&display=swap" rel="stylesheet">
    <title>Kelvin's Bistrô - Cadastro</title>
    <style>
        /* Paleta de Cores Extraída */
        :root {
            --marrom: #7A3E1F;
            --terracota: #C6754B;
            --pessego: #E7AB89;
            --azul-claro: #84AFC6;
            --azul-escuro: #28648B;
        }

        /* Estilização Geral */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            /* Fundo usando os azuis da paleta em um degradê suave */
            background: linear-gradient(135deg, var(--azul-claro) 0%, var(--azul-escuro) 100%);
        }

        /* Container do Formulário */
        .login-container {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.25);
            width: 100%;
            max-width: 350px;
            text-align: center;
            /* Borda superior combinando com a tela de login */
            border-top: 6px solid var(--terracota); 
        }

        /* Logo */
        .logo {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 50%;
            margin-bottom: 20px;
            /* Cor de pêssego para emoldurar a logo */
            border: 4px solid var(--pessego);
        }

        h2 {
            color: var(--marrom);
            margin-bottom: 25px;
            font-size: 1.5rem;
        }

        /* Inputs */
        input {
            width: 100%;
            padding: 12px 15px;
            margin-bottom: 15px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            box-sizing: border-box; 
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
            outline: none;
            color: #334155;
        }

        input:focus {
            border-color: var(--terracota);
            box-shadow: 0 0 0 3px rgba(198, 117, 75, 0.2);
        }

        /* Botão */
        button {
            width: 100%;
            padding: 12px;
            background-color: var(--terracota);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s ease, transform 0.2s ease;
        }

        button:hover {
            background-color: var(--marrom);
            transform: translateY(-2px);
        }

        button:active {
            transform: translateY(0);
        }

        /* Link extra */
        .footer-links {
            margin-top: 20px;
            font-size: 0.9rem;
            color: #64748b;
        }

        .footer-links a {
            color: var(--azul-escuro);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .footer-links a:hover {
            color: var(--terracota);
        }

        .texto-neon{
            font-family: "Praise", cursive;
            font-size: larger;
            font-style: normal;
            text-shadow: 
                #FFF 0px 0px 5px,
                #FFF 0px 0px 10px,
                #28648B 0px 0px 15px, 
                #28648B 0px 0px 20px, 
                #28648B 0px 0px 30px, 
                #28648B 0px 0px 40px, 
                #28648B 0px 0px 50px;
            color: #FFFFFF;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <img src="https://t3.ftcdn.net/jpg/02/38/15/94/360_F_238159412_HhVnn8jBWgYG9IoRSlPw2Iz5FMZz93CH.jpg" alt="Logo MarmitaTech" class="logo">
        
        <h2><div class="texto-neon">Kelvin's Bistro</div></h2>
        
        <form action="/register" method="POST">
            <input type="text" name="username" placeholder="Usuário" required>
            <input type="password" name="password" placeholder="Senha" required>
            <button type="submit">Registrar</button>
        </form>

        <div class="footer-links">
            <p>Já tem uma conta? <a href="/login">Faça login</a></p>
        </div>
    </div>

</body>
</html>